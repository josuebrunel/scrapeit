package task

import "github.com/josuebrunel/gopkg/component"
import "scrapeit/pkg/models"
import "time"
import "scrapeit/pkg/view"

func GetEtherScanLink(address string) string {
	return "https://etherscan.io/address/" + address
}

templ TableHeadView() {
	<thead>
		<tr>
			<th class=" md:table-cell">Task ID</th>
			<th>URL</th>
			<th>Status</th>
			<th class=" md:table-cell">
				<div class="flex items-center gap-1">
					<i class="fas fa-user-circle"></i>
					Assignee
				</div>
			</th>
			<th>
				<div class="flex items-center gap-1">
					<i class="fas fa-coins"></i>
					Reward
				</div>
			</th>
			<th>
				<div class="flex items-center gap-1">
					<i class="far fa-clock"></i>
					Created
				</div>
			</th>
			<th>
				<div class="flex items-center gap-1">Actions </div>
			</th>
		</tr>
	</thead>
}

var statusBadge = map[string]string{
	"completed": "badge badge-success gap-2 whitespace-nowrap",
	"pending":   "badge badge-warning gap-2 whitespace-nowrap",
	"failed":    "badge badge-error gap-2 whitespace-nowrap",
	"claimed":   "badge badge-info gap-2 whitespace-nowrap",
}

func getStatusBadge(status string) string {
	return statusBadge[status]
}

templ TableBodyView(tt models.TaskSlice) {
	<tbody id="task-history">
		for _, t := range tt {
			<tr class="hover">
				<td>{ t.ID.String() }</td>
				<td>{ t.Input.V }</td>
				<td>
					<span class={ statusBadge[t.Status.V] }>
						{ t.Status.V }
					</span>
				</td>
				<td>{ t.Assignee.V }</td>
				<td>{ t.RewardWei.V.String() } Wei</td>
				<td>{ t.CreatedAt.V.UTC().Format(time.DateTime) }</td>
				<td class="flex items-center gap-1">
					<button class="btn btn-xs btn-outline" hx-target="#content" hx-get={ view.Reverse(ctx, HandlerNameDetail, t.ID.String()) }>
						<i class="fas fa-eye"></i>View
					</button>
				</td>
			</tr>
		}
	</tbody>
}

templ TableView(tt models.TaskSlice) {
	<div class="overflow-x-auto">
		@component.Table(templ.Attributes{"class": "table table-zebra w-full"}) {
			@TableHeadView()
			@TableBodyView(tt)
		}
	</div>
}

templ ListView(tt models.TaskSlice) {
	<div id="history-page" class="page-transition ">
		<div class="flex justify-between items-center mb-8">
			<h1 class="text-3xl font-bold">Task History</h1>
			<div class="flex gap-4">
				<div class="form-control">
					<div class="input-group">
						<input
							type="text"
							placeholder="Search tasks..."
							class="input input-bordered"
							id="history-search"
						/>
						<button class="btn btn-square" onclick="searchTasks()">
							<i class="fas fa-search"></i>
						</button>
					</div>
				</div>
			</div>
		</div>
		@TableView(tt)
	</div>
}

templ DetailView(t models.Task) {
	<div id="task-detail-page" class="page-transition ">
		<button class="btn btn-ghost mb-6" hx-target="#content" hx-get={ view.Reverse(ctx, HandlerNameList) }>
			<i class="fas fa-arrow-left mr-2"></i> Back to History
		</button>
		<div class="card bg-base-100 shadow-xl mb-6">
			<div class="card-body">
				<h2 class="card-title mb-4 flex flex-col md:flex-row gap-2">
					<span>Task Details: <span id="task-id">{ t.ID.String() }</span></span>
					<span class="badge badge-outline">
						<i class="fab fa-ethereum mr-1"></i>
						<span id="task-reward">0.0 ETH</span>
					</span>
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
					<div class="stat">
						<div class="stat-title">Status</div>
						<div class="stat-value text-primary" id="detail-status">{ t.Status.V }</div>
					</div>
					<div class="stat">
						<div class="stat-title">Created (UTC)</div>
						<div class="stat-value" id="detail-created">{ t.CreatedAt.V.UTC().Format(time.DateTime) }</div>
						<div class="stat-desc" id="detail-duration"></div>
					</div>
					<div class="stat">
						<div class="stat-title">Result</div>
						<div class="stat-value" id="detail-results">CID</div>
						<div class="stat-desc" id="detail-nodes">{ t.Output.V }</div>
					</div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
					<div class="stat">
						<div class="stat-title">
							<i class="fab fa-ethereum mr-2"></i>
							Smart Contract
						</div>
						<div class="stat-value">
							<a
								href={ templ.SafeURL(GetEtherScanLink(t.Contract.V)) }
								class="link"
							>
								<div class="font-mono text-sm truncate" id="task-contract">{ t.Contract.V }</div>
							</a>
						</div>
						<div class="stat-desc">View on Etherscan</div>
					</div>
					<div class="stat">
						<div class="stat-title">
							<i class="fas fa-user-circle mr-2"></i>
							Assignee
						</div>
						<div class="stat-value">
							<a
								href={ templ.SafeURL(GetEtherScanLink(t.Assignee.V)) }
								class="link"
							>
								<div class="font-mono text-sm truncate" id="task-assignee">{ t.Assignee.V }</div>
							</a>
						</div>
						<div class="stat-desc">ETH address</div>
					</div>
					@PaymentStatusView(t)
				</div>
				<div class="divider"></div>
				<div class="tabs tabs-boxed bg-base-200 mb-4">
					<span class="tab tab-active" id="results-tab" onclick="switchTab(this)">Results</span>
					<span class="tab" id="raw-tab" onclick="switchTab(this)">Raw Data</span>
					<span class="tab" id="request-tab" onclick="switchTab(this)">Request</span>
				</div>
				<div id="tab-content" class="tab-content">
					// result content
					@ResultContentView(t)
					// Raw content
					@RawContentView(t)
					// Request
					@RequestDetailView(t)
				</div>
			</div>
		</div>
		<div class="flex justify-end gap-4">
			<button class="btn btn-error btn-outline" id="cancel-task-btn" onclick="confirmCancelTask()">
				<i class="fas fa-times-circle mr-2"></i> Cancel Task
			</button>
			<button class="btn btn-secondary" onclick="downloadResults()">
				<i class="fas fa-download mr-2"></i> Download Results
			</button>
		</div>
	</div>
}

templ PaymentStatusView(t models.Task) {
	<div class="stat">
		<div class="stat-title">
			<i class="fas fa-coins mr-2"></i>
			Payment Status
		</div>
		if t.Paid.V {
			<div class="stat-value">
				<span class="badge badge-success" id="payment-status">Paid</span>
			</div>
			<div class="stat-desc" id="payment-amount">{ t.RewardWei.V.String() } Wei</div>
		} else {
			<div class="stat-value">
				<span class="badge badge-error" id="payment-status">Pending</span>
			</div>
			<div class="stat-desc" id="payment-amount">0.0 Wei</div>
		}
	</div>
}

templ ResultContentView(t models.Task) {
	<div id="results-tab-content" class="tab-content">
		<div class="overflow-x-auto">
			<table class="table w-full">
				<thead id="results-head">
					<td>URL</td>
				</thead>
				<tbody id="results-body">
					<tr>
						<td>{ t.Input.V }</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
}

templ RawContentView(t models.Task) {
	<div id="raw-tab-content" class="tab-content hidden">
		<div class="mockup-window bg-base-200">
			<div class="h-64 overflow-y-auto p-4 bg-base-100">
				<pre><code id="raw-data">Loading raw data...</code></pre>
			</div>
		</div>
	</div>
}

templ RequestDetailView(t models.Task) {
	<div id="request-tab-content" class="mb-6 tab-content hidden">
		<h3 class="text-lg font-medium mb-2">Request Details</h3>
		<div class="mockup-code">
			<pre>
				<code id="detail-request">
					{ func() string{
							return string(`
								{
  									"url": "https://books.toscrape.com",
  									"selectors": {
    									"title": "h1",
    									"content": "p"
  									},
  									"options": {
    									"timeout": 30,
    									"waitForSelector": ".content"
  								}
							`)
						}() }
				</code>
			</pre>
		</div>
	</div>
}
