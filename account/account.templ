package account

import (
	"github.com/josuebrunel/gopkg/component"
	"github.com/josuebrunel/gopkg/xsession"
	"scrapeit/pkg/view"
)

type AuthType struct {
	Type string `json:"type"`
	Link string `json:"link"`
	Alt  string `json:"alt"`
}

func getAuthType(signUp bool) AuthType {
	if !signUp {
		return AuthType{
			Type: "Sign Up",
			Link: "/account/signup",
			Alt:  "Sign In",
		}
	}
	return AuthType{
		Type: "Sign In",
		Link: "/account/signin",
		Alt:  "Sign Up",
	}
}

templ SignInAndUpView(title string, attr templ.Attributes, signup bool) {
	@view.Layout(title) {
		<div id="auth-page" class="page-transition ">
			<div class="hero min-h-[80vh]">
				<div class="hero-content flex-col md:flex-row gap-12">
					<div class="text-center md:text-left md:w-1/2">
						<h1 class="text-5xl font-bold mb-6">
							<span id="auth-title">Login</span> to <span class="text-primary">Scrapions</span>
						</h1>
						<p class="text-lg mb-8">
							<span id="auth-subtitle">
								Sign in to access your dashboard, manage your API keys, and
								view your scraping history.
							</span>
						</p>
						<div class=" md:block">
							<img
								src="https://illustrations.popsy.co/amber/developer-activity.svg"
								alt="Authentication illustration"
								class="w-full max-w-md mx-auto"
							/>
						</div>
					</div>
					<div class="card flex-shrink-0 w-full max-w-sm shadow-2xl bg-base-100">
						<div class="card-body">
							// <div class="tabs tabs-boxed bg-base-200 mb-6">
							// 	<a class="tab w-1/2" id="login-tab" onclick="switchAuthTab('login')">Login</a>
							// 	<a class="tab w-1/2" id="signup-tab" onclick="switchAuthTab('signup')">Sign Up</a>
							// </div>
							<form id="auth-form" { attr... }>
								@component.InputCSRF(view.GetCSRF(ctx))
								<div class="form-control">
									<label class="label">
										<span class="label-text">Email</span>
									</label>
									<input
										id="auth-email"
										name="email"
										type="email"
										placeholder="your@email.com"
										class="input input-bordered"
										required
									/>
								</div>
								<div class="form-control">
									<label class="label">
										<span class="label-text">Password</span>
									</label>
									<input
										id="auth-password"
										name="password"
										type="password"
										placeholder="••••••••"
										class="input input-bordered"
										required
									/>
								</div>
								{{ authType := getAuthType(signup) }}
								<div class="form-control mt-6">
									<button id="auth-submit" type="submit" class="btn btn-primary">
										<span id="auth-submit-text">
											{ authType.Alt }
										</span>
									</button>
								</div>
								<div class="text-center mt-4">
									@component.Link("Forgot Password?", "#", templ.Attributes{"class": "link link-primary text-sm"})
								</div>
								<div class="text-center mt-4">
									@component.Link(authType.Type, authType.Link, templ.Attributes{"class": "link link-primary text-sm"})
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}

templ BalanceView(user xsession.XUser) {
	<div class="stat">
		<div class="stat-figure text-primary">
			<i class="fab fa-ethereum text-2xl"></i>
		</div>
		<div class="stat-title">Balance</div>
		<div class="stat-value" id="user-balance">{ user.GetData("ethBalance") }</div>
		<div class="stat-desc">ETH</div>
	</div>
}

templ EthAddressView(user xsession.XUser, attr templ.Attributes) {
	<div class="card-body">
		<h2 class="card-title mb-4">Your Wallet</h2>
		@component.Form(templ.Attributes{}) {
			@component.InputCSRF(view.GetCSRF(ctx))
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">Ethereum Address</span>
				</label>
				<div class="input-group">
					<input
						id="eth-address"
						name="ethAddress"
						type="text"
						placeholder="0x..."
						class="input input-bordered w-full"
						value={ user.GetData(DataKeyEthereumAddress) }
					/>
					<button class="btn btn-square" onclick="copyEthAddress()">
						<i class="fas fa-copy"></i>
					</button>
				</div>
				<div class="label-text-alt mt-1">
					<button class="btn btn-outline btn-sm" hx-target="#ethAddress" hx-patch="/account/update-data">
						<i class="fas fa-save mr-1"></i> Save
					</button>
				</div>
			</div>
		}
	</div>
}

func SampleAPIRequest() string {
	return string(`
	# create a task
	curl -v -H 'Content-Type: application/json' -H 'Authorization: jY4adtJM8nPtxykros0Ju0TLKcPtlRBuLrNkc7sBpjc' 
		-d '{"url": "https://propcopy.ai" }' https://scrapions.xyz/api/v1/task | jq

	# then get the result in <data.output> with the task id
	curl -v -H 'Authorization: jY4adtJM8nPtxykros0Ju0TLKcPtlRBuLrNkc7sBpjc' 
		https://scrapions.xyz/api/v1/task/43e3d8ce-25bd-4ff8-ae4e-3aabf06e3c46 | jq
	`)
}

func SamplePython() string {
	return string(`
	# 1. CREATE A TASK
	import requests

	url = "https://scrapions.xyz/api/v1/task"

	payload = {
		"url": "https://propcopy.ai"
	}
	headers = {
		"Content-Type": "application/json",
		"Authorization": "jY4adtJM8nPtxykros0Ju0TLKcPtlRBuLrNkc7sBpjc"
	}
	response = requests.post(url, json=payload, headers=headers)
	print(response.text)

	# 2. GET THE RESULT
	# then get the result in <data.output> with the task id
	task_id = response.json().get('id')
	result_url = f"https://scrapions.xyz/api/v1/task/{task_id}"
	response = requests.get(result_url, headers=headers)
	print(response.text)
	output = response.json().get('data').get('output')
	print(output)
	`)
}

templ DashboardView(user xsession.XUser, attr templ.Attributes) {
	@view.Layout("Dashboard") {
		<div id="dashboard-page" class="page-transition ">
			<div class="flex flex-col md:flex-row gap-8">
				<div id="user-info" class="md:w-1/3">
					<div class="card bg-base-100 shadow-xl mb-6">
						<div class="card-body">
							<div class="flex items-center gap-4 mb-4">
								<div class="avatar">
									<div
										class="w-16 rounded-full bg-accent text-accent-content flex items-center justify-center"
									>
										<i class="fas fa-user text-2xl"></i>
									</div>
								</div>
								<div>
									<h2 class="card-title" id="user-name">{ user.Email }</h2>
									// <p class="text-sm opacity-70">Premium Member</p>
								</div>
							</div>
							<div class="stats shadow bg-base-200">
								<div class="stat">
									<div class="stat-figure text-secondary">
										<i class="fas fa-tasks text-2xl"></i>
									</div>
									<div class="stat-title">Active Tasks</div>
									<div class="stat-value" id="active-tasks">0</div>
									<div class="stat-desc">running now</div>
								</div>
								// ETH Balance
								@BalanceView(user)
							</div>
						</div>
					</div>
					// Eth Address
					<div id="ethAddress" class="card bg-base-100 shadow-xl mb-6" hx-get="/account/update-data" hx-target="#ethAddress" hx-trigger="load"></div>
					// ApiKey component
					<div id="apiKey" class="card bg-base-100 shadow-xl" hx-get="/account/apikey" hx-target="#apiKey" hx-trigger="load"></div>
				</div>
				<div id="content" class="md:w-2/3">
					<div class="card bg-base-100 shadow-xl mb-6">
						<div class="card-body">
							<h2 class="card-title mb-4">Quick Start</h2>
							<div class="grid grid-cols-1 gap-4 mb-6">
								<button class="btn btn-outline" hx-target="#content" hx-get="/task">
									<i class="fas fa-history mr-2"></i> View Task History
								</button>
							</div>
							<div class="divider">OR</div>
							<h3 class="text-lg font-medium mb-2">Sample API Request</h3>
							<div class="mockup-code mb-4">
								<pre>
									<code>{ SampleAPIRequest() } </code>
								</pre>
							</div>
							<div class="collapse collapse-plus bg-base-200 mb-2">
								<input type="checkbox"/>
								<div class="collapse-title text-md font-medium">
									Python Example
								</div>
								<div class="collapse-content">
									<pre>
										<code class="language-python">{ SamplePython() } </code>
									</pre>
								</div>
							</div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-xl">
						<div class="card-body">
							<h2 class="card-title mb-4">Recent Activity</h2>
							<span hx-get="/task?table=true&limit=3" hx-trigger="load"></span>
							<div class="card-actions justify-end mt-4">
								<button class="btn btn-ghost btn-sm" hx-target="#content" hx-get="/task">
									View All <i class="fas fa-arrow-right ml-2"></i>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
