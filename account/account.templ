								</button>
							</div>
							<div class="divider">OR</div>
							<h3 class="text-lg font-medium mb-2">Sample API Request</h3>
							<div class="mockup-code mb-4">
								<pre>
									<code>
										piece of code here
										//									// Make a POST request to:
										//									https://api.scrapions.com/v1/scrape
										//
										//									// With headers:
										//									"Authorization": "Bearer YOUR_API_KEY"
										//									"Content-Type": "application/json"
										//
										//									// And JSON body:
										//									{
										//									"url": "https://example.com",
										//									"selectors": {
										//										"title": "h1",
										//										"content": "article p"
										//									}
										//									}
									</code>
								</pre>
							</div>
							<div class="collapse collapse-plus bg-base-200 mb-2">
								<input type="checkbox"/>
								<div class="collapse-title text-md font-medium">
									Node.js Example
								</div>
								<div class="collapse-content">
									<pre>
										<code class="language-javascript">
											code example
											// const axios = require('axios');
											// 
											// async function scrapeExample() {
											//   try {
											//     const response = await axios.post('https://api.scrapions.com/v1/scrape', {
											//       url: 'https://example.com',
											//       selectors: {
											//         title: 'h1',
											//         content: 'article p'
											//       }
											//     }, {
											//       headers: {
											//         'Authorization': 'Bearer YOUR_API_KEY',
											//         'Content-Type': 'application/json'
											//       }
											//     });
											//     
											//     console.log(response.data);
											//   } catch (error) {
											//     console.error('Scraping error:', error.response.data);
											//   }
											// }
											// 
											// scrapeExample();
										</code>
									</pre>
								</div>
							</div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-xl">
						<div class="card-body">
							<h2 class="card-title mb-4">Recent Activity</h2>
							<span hx-get="/task?table=true&limit=3" hx-trigger="load"></span>
							<div class="card-actions justify-end mt-4">
